# Comma-separated list of AI server IPs/hostnames to probe.
# Ollama servers are detected on port 11434; OpenAI-compatible
# servers (vLLM, SGLang, llama.cpp) on ports 8000-8010.
AI_HOSTS=127.0.0.1

# Embedding service used for semantic similarity scoring.
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8002
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Optional shared secret for the batch API endpoint.
APP_API_KEY=
